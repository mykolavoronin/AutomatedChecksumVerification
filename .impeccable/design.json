      "html": "<label class=\"ds-label\" for=\"ds-expected\">Expected checksum</label><textarea id=\"ds-expected\" class=\"ds-field\" rows=\"3\" placeholder=\"Paste a digest\" spellcheck=\"false\"></textarea>",
      "css": ".ds-label{display:block;font:650 12px system-ui,sans-serif;margin-bottom:6px;color:var(--text,#202020)}.ds-field{font:12px/1.6 ui-monospace,\"Cascadia Code\",monospace;width:100%;min-height:38px;border:1px solid #b8b8b8;border-radius:6px;background:var(--surface,#fff);color:var(--text,#202020);padding:8px 10px;resize:vertical}.ds-field::placeholder{color:var(--muted,#666);opacity:1}.ds-field:focus-visible{outline:3px solid var(--focus,#555);outline-offset:3px}"
