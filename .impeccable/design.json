    {
      "name": "Report navigation",
      "kind": "nav",
      "description": "Soft selected surface in the wide rail.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Report sections\"><button aria-current=\"page\"><svg class=\"ds-icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M7 3h7l4 4v14H6V3h1Zm7 0v5h4M9 12h6M9 16h6\"/></svg>Downloads</button><button><svg class=\"ds-icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M7 3h7l4 4v14H6V3h1Zm7 0v5h4M8.5 14l2 2 4-4\"/></svg>Verify a file</button><button>Settings</button></nav>",
      "css": ".ds-nav{display:flex;flex-direction:column;gap:6px;width:190px;background:var(--glass,rgba(255,255,255,.82));backdrop-filter:blur(22px) saturate(0%);padding:20px 12px;border-right:1px solid var(--border,#dedede)}.ds-nav button{font:600 13px system-ui,sans-serif;text-align:left;padding:12px;min-height:38px;border:0;border-radius:10px;background:transparent;color:var(--muted,#666);cursor:pointer}.ds-nav button[aria-current=page]{background:var(--soft,#f2f2f2);color:var(--accent,#292929)}.ds-nav button:hover{background:var(--bg,#f7f7f7);color:var(--text,#202020)}.ds-nav button:focus-visible{outline:3px solid var(--focus,#555);outline-offset:3px}.ds-icon{display:inline-block;width:18px;height:18px;vertical-align:middle;flex-shrink:0;pointer-events:none;margin-right:7px}"
