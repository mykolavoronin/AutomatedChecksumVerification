      "css": ".ds-button{font:600 14px/1.3 system-ui,sans-serif;min-height:38px;border:1px solid transparent;border-radius:10px;padding:8px 12px;cursor:pointer;transition:background-color .15s ease-out,border-color .15s ease-out,scale .12s ease-out}.ds-button:focus-visible{outline:3px solid var(--focus,#555);outline-offset:3px}.ds-button:active{scale:.96}@media(prefers-reduced-motion:reduce){.ds-button{transition:none}.ds-button:active{scale:1}}.ds-text{background:transparent;color:var(--accent,#292929);padding-inline:5px}.ds-text:hover{background:var(--soft,#f2f2f2)}.ds-icon{display:inline-block;width:18px;height:18px;vertical-align:middle;flex-shrink:0;pointer-events:none;margin-right:7px}"
